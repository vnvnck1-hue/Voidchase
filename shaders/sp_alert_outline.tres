[gd_resource type="VisualShader" format=3]

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_hteqf"]
parameter_name = "ppx"
hint = 1
min = 0.01
max = 64.0
default_value_enabled = true
default_value = 1.0

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_5omhu"]
parameter_name = "t"
hint = 1
max = 100000.0
default_value_enabled = true

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_3ud5r"]
parameter_name = "strength"
hint = 1
default_value_enabled = true

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_nrf3q"]
parameter_name = "premult"
hint = 1
default_value_enabled = true

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_ole0h"]
parameter_name = "outline_px"
hint = 1
max = 12.0
default_value_enabled = true
default_value = 3.5

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_v6cf5"]
parameter_name = "glow_px"
hint = 1
max = 30.0
default_value_enabled = true
default_value = 9.0

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_f6ubp"]
parameter_name = "pulse_speed"
hint = 1
max = 20.0
default_value_enabled = true
default_value = 4.6

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_oc8eb"]
parameter_name = "sweep_speed"
hint = 1
max = 4.0
default_value_enabled = true
default_value = 0.55

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_m8e8g"]
parameter_name = "sweep_width"
hint = 1
min = 0.005
max = 0.5
default_value_enabled = true
default_value = 0.07

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_jf5po"]
parameter_name = "sweep_gain"
hint = 1
max = 2.0
default_value_enabled = true
default_value = 0.5

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_tlcpi"]
parameter_name = "line_color"
default_value_enabled = true
default_value = Color(1, 0.82, 0.25, 1)

[sub_resource type="VisualShaderNodeVectorDecompose" id="VisualShaderNodeVectorDecompose_y2adj"]
default_input_values = [0, Quaternion(0, 0, 0, 0)]
op_type = 2

[sub_resource type="VisualShaderNodeVectorCompose" id="VisualShaderNodeVectorCompose_3a0v4"]

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_q56l2"]
parameter_name = "core_color"
default_value_enabled = true
default_value = Color(1, 0.98, 0.9, 1)

[sub_resource type="VisualShaderNodeVectorDecompose" id="VisualShaderNodeVectorDecompose_b2e5m"]
default_input_values = [0, Quaternion(0, 0, 0, 0)]
op_type = 2

[sub_resource type="VisualShaderNodeVectorCompose" id="VisualShaderNodeVectorCompose_wpwn6"]

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_5k7qw"]
parameter_name = "body_tint"
default_value_enabled = true

[sub_resource type="VisualShaderNodeVectorDecompose" id="VisualShaderNodeVectorDecompose_vgxds"]
default_input_values = [0, Quaternion(0, 0, 0, 0)]
op_type = 2

[sub_resource type="VisualShaderNodeVectorCompose" id="VisualShaderNodeVectorCompose_fsjq4"]

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_wxixn"]
input_name = "uv"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_e8jb2"]
size = Vector2(560, 604)
expression = "
vec2 m = step(frame_rect.xy, uv) * step(uv, frame_rect.zw);
vec4 c = texture(TEXTURE, uv) * (m.x * m.y);
if (premult > 0.5 && c.a > 0.0001) {
	c.rgb /= c.a;
}
float k = clamp(strength, 0.0, 1.0);
vec2 px = tex_px * ppx;
float pulse = 0.5 + 0.5 * sin(t * pulse_speed);
// 네온 선: 실루엣 밖 line_r 안 (두 반지름으로 채워 두껍게), 코어: 실루엣에 붙은 안쪽 40%, 글로우: 그 바깥 두 고리
float line_r = (outline_px + 1.5 * pulse) * k;
float glow_w = glow_px * k * (0.8 + 0.4 * pulse);
float a_line = 0.0;
float a_core = 0.0;
float a_g1 = 0.0;
float a_g2 = 0.0;
if (k > 0.001) {
	// 반지름마다 둘레 여러 방향의 알파 최댓값 (프레임 사각형 밖은 0). 내장 TEXTURE 는 함수 인자로 못 넘겨 여기서 바로 돈다
	for (int i = 0; i < 16; i++) {
		float fi = float(i);
		vec2 d16 = vec2(cos(fi * 0.3926991), sin(fi * 0.3926991));
		vec2 u = uv + d16 * px * line_r;
		vec2 mm = step(frame_rect.xy, u) * step(u, frame_rect.zw);
		a_line = max(a_line, textureLod(TEXTURE, u, 0.0).a * mm.x * mm.y);
		if (i < 12) {
			vec2 d12 = vec2(cos((fi + 0.3) * 0.5235988), sin((fi + 0.3) * 0.5235988));
			u = uv + d12 * px * (line_r + glow_w * 0.45);
			mm = step(frame_rect.xy, u) * step(u, frame_rect.zw);
			a_g1 = max(a_g1, textureLod(TEXTURE, u, 0.0).a * mm.x * mm.y);
			d12 = vec2(cos((fi + 0.7) * 0.5235988), sin((fi + 0.7) * 0.5235988));
			u = uv + d12 * px * (line_r + glow_w);
			mm = step(frame_rect.xy, u) * step(u, frame_rect.zw);
			a_g2 = max(a_g2, textureLod(TEXTURE, u, 0.0).a * mm.x * mm.y);
		}
		if (i < 8) {
			vec2 d8 = vec2(cos((fi + 0.5) * 0.7853982), sin((fi + 0.5) * 0.7853982));
			u = uv + d8 * px * line_r * 0.5;
			mm = step(frame_rect.xy, u) * step(u, frame_rect.zw);
			a_line = max(a_line, textureLod(TEXTURE, u, 0.0).a * mm.x * mm.y);
			d8 = vec2(cos((fi + 0.25) * 0.7853982), sin((fi + 0.25) * 0.7853982));
			u = uv + d8 * px * line_r * 0.4;
			mm = step(frame_rect.xy, u) * step(u, frame_rect.zw);
			a_core = max(a_core, textureLod(TEXTURE, u, 0.0).a * mm.x * mm.y);
		}
	}
}
float outside = 1.0 - c.a;
float line = clamp(a_line - c.a, 0.0, 1.0) * k;
float core = clamp(a_core - c.a, 0.0, 1.0);
float glow = max(clamp(a_g1 - a_line, 0.0, 1.0) * (0.55 + 0.25 * pulse), clamp(a_g2 - a_g1, 0.0, 1.0) * (0.25 + 0.15 * pulse)) * k;
// 스캔 띠: 프레임 아래에서 위로 훑는다 (v 0 위 → 1 아래). 띠가 지나는 자리의 선은 하얗게, 몸은 선 색으로 번쩍
float v = (uv.y - frame_rect.y) / max(frame_rect.w - frame_rect.y, 0.00001);
float band_y = 1.2 - fract(t * sweep_speed) * 1.5;
float band = (1.0 - smoothstep(0.0, sweep_width, abs(v - band_y))) * k;
float tail = (1.0 - smoothstep(0.0, sweep_width * 4.0, v - band_y)) * step(band_y, v) * 0.35 * k;
vec3 line_rgb = mix(line_color, core_color, clamp(core * 0.75 + band, 0.0, 1.0));
vec3 body = c.rgb * body_tint;
body += line_color * (band + tail) * sweep_gain;
body += line_color * 0.08 * pulse * k;
// 합성: 몸 위에 선, 그 바깥에 글로우 (출력은 스트레이트 알파)
float edge_a = line;
float glow_a = glow * (1.0 - line);
float out_a = c.a + (edge_a + glow_a) * outside;
color = (body * c.a + line_rgb * edge_a * outside + line_color * glow_a * outside) / max(out_a, 0.0001);
alpha = out_a;
"

