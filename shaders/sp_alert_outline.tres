[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_16v5x"]
size = Vector2(560, 230)
expression = "
vec2 sgn = sign(uv - (rect.xy + rect.zw) * 0.5);
out_vertex = vertex + sgn * pad;
out_uv = uv + sgn * pad * tex_px;
"

