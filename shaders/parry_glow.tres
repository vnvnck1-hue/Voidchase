parameter_name = "alpha_k"
hint = 1
default_value_enabled = true
default_value = 1.0

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_syxrb"]
parameter_name = "col_core"
default_value_enabled = true

[sub_resource type="VisualShaderNodeVectorDecompose" id="VisualShaderNodeVectorDecompose_5p2so"]
default_input_values = [0, Quaternion(0, 0, 0, 0)]
op_type = 2

[sub_resource type="VisualShaderNodeVectorCompose" id="VisualShaderNodeVectorCompose_g7t87"]

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_neqrx"]
parameter_name = "col_glow"
default_value_enabled = true
default_value = Color(1, 0.188, 0, 1)

[sub_resource type="VisualShaderNodeVectorDecompose" id="VisualShaderNodeVectorDecompose_1sg2b"]
default_input_values = [0, Quaternion(0, 0, 0, 0)]
op_type = 2

[sub_resource type="VisualShaderNodeVectorCompose" id="VisualShaderNodeVectorCompose_g0yxi"]

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_anfic"]
input_name = "uv"

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_sgpa1"]
input_name = "time"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_h5h26"]
size = Vector2(700, 502)
expression = "vec2 p = uv - 0.5;
float d = length(p) * 2.0;
float core = 1.0 - smoothstep(core_r - 0.015, core_r + 0.015, d);
float g = exp(-pow(max(d - core_r, 0.0) / max(glow_r, 0.001), 1.35) * 2.4);
float ring = (1.0 - smoothstep(0.0, ring_w, abs(d - ring_r))) * ring_a;
float ang = atan(p.y, p.x) + spin + time * 0.6;
float ray = pow(abs(cos(ang * rays * 0.5)), 28.0) * smoothstep(1.0, 0.15, d) * smoothstep(core_r, core_r + 0.12, d) * ray_a;
float edge = 1.0 - smoothstep(0.86, 1.0, d);
vec3 c = col_core * core + col_glow * (g * (1.0 - core) + ray) + mix(col_glow, vec3(1.0), 0.65) * ring;
rgb_out = c * edge * alpha_k;
a_out = 1.0;"

