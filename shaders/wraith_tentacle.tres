default_value_enabled = true
default_value = Color(0.38, 0.17, 0.72, 1)

[sub_resource type="VisualShaderNodeVectorDecompose" id="VisualShaderNodeVectorDecompose_kb0lw"]
default_input_values = [0, Quaternion(0, 0, 0, 0)]
op_type = 2

[sub_resource type="VisualShaderNodeVectorCompose" id="VisualShaderNodeVectorCompose_s3e5k"]

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_cbe7q"]
parameter_name = "col_tip"
default_value_enabled = true
default_value = Color(0.86, 0.62, 1, 1)

[sub_resource type="VisualShaderNodeVectorDecompose" id="VisualShaderNodeVectorDecompose_bh4wx"]
default_input_values = [0, Quaternion(0, 0, 0, 0)]
op_type = 2

[sub_resource type="VisualShaderNodeVectorCompose" id="VisualShaderNodeVectorCompose_iab7b"]

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_10t3d"]
parameter_name = "col_sheen"
default_value_enabled = true
default_value = Color(0.74, 0.4, 1, 1)

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_mlvja"]
parameter_name = "body_w"
hint = 1
min = 0.1
default_value_enabled = true
default_value = 0.6

[sub_resource type="VisualShaderNodeVectorDecompose" id="VisualShaderNodeVectorDecompose_m7hx5"]
default_input_values = [0, Quaternion(0, 0, 0, 0)]
op_type = 2

[sub_resource type="VisualShaderNodeVectorCompose" id="VisualShaderNodeVectorCompose_oq5f7"]

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_hgtkk"]
parameter_name = "col_glow"
default_value_enabled = true
default_value = Color(0.56, 0.2, 0.98, 1)

[sub_resource type="VisualShaderNodeVectorDecompose" id="VisualShaderNodeVectorDecompose_wso3w"]
default_input_values = [0, Quaternion(0, 0, 0, 0)]
op_type = 2

[sub_resource type="VisualShaderNodeVectorCompose" id="VisualShaderNodeVectorCompose_au2xw"]

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_o0vm5"]
input_name = "uv"

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_5rybm"]
input_name = "time"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_px00d"]
size = Vector2(700, 570)
expression = "float along = uv.x;
float side = (uv.y - 0.5) * 2.0;                      // -1..1
// 굵기: 뿌리 굵고 → 끝 가늘게 → 둥근 끝
float taper = 1.0 - smoothstep(0.1, 1.0, along);
float wide = mix(tip_w, 1.0, pow(taper, 0.8));
wide *= sqrt(clamp((0.975 - along) / 0.04, 0.0, 1.0));
float half_body = body_w * wide;
float dist = abs(side);
float soft = 0.03;
float body = (1.0 - smoothstep(half_body - soft, half_body + soft, dist)) * step(0.0005, wide);
// 길이 방향 색
vec3 shade = mix(col_base, col_mid, smoothstep(0.04, 0.48, along));
shade = mix(shade, col_tip, smoothstep(0.42, 0.93, along));
// 몸통 안 가로 좌표 -1..1
float inner = side / max(half_body, 0.001);
// 한쪽 가장자리를 따라 흐르는 밝은 띠
float streak = 0.55 + 0.45 * sin(along * 10.0 - time * flow_speed + seed * 6.2831);
float sheen = exp(-pow((inner - 0.38) / 0.34, 2.0)) * smoothstep(0.1, 0.55, along) * streak;
shade = mix(shade, col_sheen, sheen * 0.8);
// 반대쪽은 어둡게 (끝으로 갈수록 풀린다)
shade *= 1.0 - 0.4 * smoothstep(0.0, -1.0, inner) * (1.0 - smoothstep(0.45, 0.95, along));
// 가장자리 보랏빛 테
float rim = smoothstep(0.7, 1.0, abs(inner));
shade = mix(shade, col_glow * 1.2, rim * 0.6 * smoothstep(0.08, 0.5, along));
// 찌른 순간 끝이 번쩍
shade = mix(shade, vec3(1.0, 0.95, 1.0), flash * smoothstep(0.55, 0.97, along) * 0.85);
// 바깥: 가운데~끝은 후광, 뿌리는 어두운 연기
float out_d = max(dist - half_body, 0.0);
float halo = exp(-out_d / max(glow_w, 0.001)) * (1.0 - body);
float lit = smoothstep(0.06, 0.4, along);
float tip_fade = 1.0 - smoothstep(0.985, 1.0, along);
float strip = smoothstep(1.0, 0.82, dist) * smoothstep(0.0, 0.03, along) * tip_fade;
float pulse = 0.85 + 0.15 * sin(time * 9.0 + seed * 4.0 + along * 5.0);
vec3 halo_rgb = col_glow * halo * lit * glow_i * pulse * (1.0 + flash * 1.5 * smoothstep(0.5, 1.0, along));
float smoke = halo * (1.0 - lit) * 0.55;
float root_fade = smoothstep(0.0, 0.035, along);
rgb_out = (shade * body * root_fade + halo_rgb * strip) * alpha_k;
a_out = (body * root_fade + (smoke + halo * lit * 0.22) * strip * (1.0 - body)) * alpha_k;"

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_q2sqw"]
parameter_name = "tip_w"
hint = 1
min = 0.02
default_value_enabled = true
default_value = 0.16

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_8mrl4"]
parameter_name = "glow_w"
hint = 1
