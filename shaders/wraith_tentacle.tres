default_value = Color(0.13, 0.07, 0.25, 1)

[sub_resource type="VisualShaderNodeVectorDecompose" id="VisualShaderNodeVectorDecompose_mbhh7"]
default_input_values = [0, Quaternion(0, 0, 0, 0)]
