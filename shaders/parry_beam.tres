[gd_resource type="VisualShader" format=3]

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_dkxnc"]
input_name = "uv"

[sub_resource type="VisualShaderNodeTexture" id="VisualShaderNodeTexture_fp37e"]
source = 2

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_japb1"]
input_name = "uv"

[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_ajvsi"]
input_name = "time"

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_ali2t"]
size = Vector2(700, 366)
expression = "// 밑동에서 잰 거리 0..1
float h = mix(uv.y, 1.0 - uv.y, base);
float mask = 1.0 - smoothstep(reveal - 0.12, reveal + 0.02, h);
// 세로 결: 가는 빛줄기 다발
float streak = 0.72 + 0.28 * sin(uv.x * 52.0 + sin(uv.x * 17.0) * 2.5);
// 밑동에서 끝으로 흐르는 밝은 띠
float band = fract(h * 0.9 - time * flow * 0.5);
float run = exp(-pow((band - 0.5) * 5.5, 2.0));
vec3 c = tex.rgb * tint * gain * streak * (0.82 + 0.5 * run);
c += vec3(1.0, 1.0, 0.85) * run * 0.22 * gain;
rgb_out = c * tex.a * mask * alpha_k;
a_out = 1.0;"

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_feb2v"]
parameter_name = "gain"
hint = 1
max = 4.0
default_value_enabled = true
default_value = 1.0

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_vrgke"]
parameter_name = "reveal"
hint = 1
default_value_enabled = true
default_value = 1.0

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_5pfnp"]
parameter_name = "base"
hint = 1
default_value_enabled = true
default_value = 1.0

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_af4eh"]
parameter_name = "flow"
hint = 1
max = 8.0
default_value_enabled = true
default_value = 1.6

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_sk38x"]
parameter_name = "alpha_k"
hint = 1
default_value_enabled = true
default_value = 1.0

[sub_resource type="VisualShaderNodeColorParameter" id="VisualShaderNodeColorParameter_q6ycw"]
parameter_name = "tint"
default_value_enabled = true

[sub_resource type="VisualShaderNodeVectorDecompose" id="VisualShaderNodeVectorDecompose_wbbvi"]
default_input_values = [0, Quaternion(0, 0, 0, 0)]
op_type = 2

[sub_resource type="VisualShaderNodeVectorCompose" id="VisualShaderNodeVectorCompose_m1ss0"]

