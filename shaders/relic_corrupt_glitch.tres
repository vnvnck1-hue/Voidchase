float big_t = floor(t * 3.0);
float big = step(0.9 - jolt * 0.6, rc_hash(vec2(big_t, seed * 7.0 + 5.0)));
sh += big * (rc_hash(vec2(floor((p.y + 400.0) / 14.0), big_t + 9.0)) - 0.5) * 28.0;
