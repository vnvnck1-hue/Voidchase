[sub_resource type="VisualShaderNodeInput" id="VisualShaderNodeInput_n6qbm"]
input_name = "time"

[sub_resource type="VisualShaderNodeFloatParameter" id="VisualShaderNodeFloatParameter_75kn8"]
parameter_name = "tail_r"
hint = 1
min = 0.5
max = 12.0
default_value_enabled = true
default_value = 4.5

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_1xisy"]
size = Vector2(620, 298)
expression = "float r = max(radius_px, 0.001);
along = (head_px - uv.x) / r;
across = (uv.y - 0.5) * 2.0 * half_w_px / r;
float t = (time + time_offset) * scroll_speed;
// 노이즈 A: 크게, 꼬리 쪽으로 흘러간다 (along - t). B: 잘게, 더 빨리
uv_a = fract(vec2(across * 0.09 + time_offset * 0.37, (along - t * 9.0) * 0.08));
uv_b = fract(vec2(across * 0.16 + time_offset * 0.61, (along - t * 14.0) * 0.15));
// 띠 메시 가장자리에서 후광이 칼같이 잘리지 않게
edge_fade = smoothstep(0.0, 0.06, uv.y) * smoothstep(1.0, 0.94, uv.y) * smoothstep(0.0, r * 1.5, uv.x);   // 출발점(띠 시작)에서도 부드럽게"

[sub_resource type="FastNoiseLite" id="FastNoiseLite_hxuji"]
